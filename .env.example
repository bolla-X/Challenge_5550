# OBRIGATORIO trocar: e o que assina a sessao de login. Com o valor padrao
# do repositorio, qualquer pessoa forja o cookie de um supervisor — por
# isso a aplicacao se RECUSA a subir com ele fora de FLASK_DEBUG.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Deixe VAZIO e preencha com uma chave sua: a aplicacao recusa subir com
# qualquer valor que conste neste repositorio, e com menos de 32 caracteres.
SECRET_KEY=

# Autenticacao. Desligar so faz sentido em teste automatizado.
AUTH_REQUIRED=true
# LIGUE atras de HTTPS. Fica false por padrao porque cookie Secure nao
# viaja em http://localhost e quebraria o desenvolvimento.
SESSION_COOKIE_SECURE=false
# Quanto tempo a sessao dura sem novo login.
SESSION_HOURS=12

# Porta unica do backend — usada por run.py, Dockerfile, docker-compose e
# pelo proxy do Vite em dev. Mude aqui e muda em todos.
HOST=0.0.0.0
PORT=5000
# NUNCA true em producao: liga o console interativo do Werkzeug (RCE).
FLASK_DEBUG=false
# DATABASE_URL=postgresql+psycopg2://visionepi:visionepi@localhost:5432/visionepi  # opcional -- sem isso usa SQLite local, recomendado pra testar/clonar
# Quem e dono do esquema e o Alembic (`flask --app wsgi db upgrade`).
# ISTO PRECISA FICAR false. Com true, `create_app()` chama `db.create_all()` —
# e o CLI do Flask constroi a aplicacao ANTES de executar o subcomando, entao
# as tabelas nascem sem `alembic_version` e o `db upgrade` seguinte morre com
# "table alerts already exists" num clone limpo. Ligue so se quiser um banco
# descartavel sem migracao. Coberto por tests/test_onboarding.py.
AUTO_CREATE_TABLES=false
VIDEO_SOURCE=0
FRAME_WIDTH=960
FRAME_HEIGHT=540
TARGET_FPS=12
JPEG_QUALITY=80

# Modelo YOLOv8m treinado para EPIs (Hexmon/vyra-yolo-ppe-detection, CC-BY-4.0).
# 14 classes: Fall-Detected, Gloves, Goggles, Hardhat, Ladder, Mask, NO-Gloves,
# NO-Goggles, NO-Hardhat, NO-Mask, NO-Safety Vest, Person, Safety Cone, Safety Vest.
#
# Os pesos NAO estao no repositorio (.gitignore: *.pt). Baixe de
# https://huggingface.co/Hexmon/vyra-yolo-ppe-detection e salve como
# models/vyra_ppe.pt. A licenca CC-BY-4.0 exige atribuicao ao autor.
#
# Alternativa sem classe "person" (exige MULTI_PERSON_DETECTION=true e
# YOLO_CLASSES vazio): Tanishjain9/yolov8n-ppe-detection-6classes, MIT,
# em models/epi_pretrained.pt.
# Aponte para o .pt para rodar no PyTorch, ou para o diretorio exportado
# *_openvino_model para usar o runtime da Intel — 5,6x mais rapido nesta
# classe de CPU (24 ms/frame contra 186 ms). Gerar o diretorio com:
#   YOLO("models/vyra_ppe.pt").export(format="openvino", imgsz=416)
# ATENCAO: o OpenVINO CONGELA a resolucao na exportacao — YOLO_IMGSZ abaixo
# precisa bater com o imgsz usado no export, senao a aplicacao recusa subir
# com uma mensagem explicando (ver YoloPPEDetector._validar_imgsz).
# O default e o .pt, que e o unico runtime que o requirements.txt instala.
# O diretorio *_openvino_model continua suportado pelo codigo, mas o OpenVINO
# foi avaliado e REJEITADO (ver comentario no requirements.txt) e nao e
# instalado: apontar para ele aqui fazia a instalacao documentada nao subir.
#
# --- Sprint 4: peso PROPRIO, treinado no dominio ---------------------------
# models/visionepi_cppe_n416.pt = YOLOv8n (COCO) ajustado no dataset
# Construction-PPE (Ultralytics, AGPL-3.0) a imgsz=416, a mesma resolucao em
# que o pipeline roda. Um peso so para pessoa + 5 EPIs + 5 classes negativas
# (no_helmet, none = torso sem colete, no_gloves, no_goggle, no_boots).
# Versionado (6,2 MB) para o projeto rodar sem 2,6 h de treino; reproduzivel
# com scripts/baixar_dataset.py + scripts/treinar_modelo.py.
#
# Por que trocou, medido POR PESSOA no conjunto de teste (docs/SPRINT4.md):
#   alerta "sem capacete" : precisao 0,39 -> 0,85 · revocacao 0,87 -> 0,92
#   alerta "sem colete"   : precisao 0,34 -> 0,87 · revocacao 0,79 -> 0,69
#   inferencia por imagem : 354 ms -> 49 ms (Vyra m + COCO n -> um n so)
# O Vyra continua suportado: PPE_MODEL_PATH=models/vyra_ppe.pt,
# YOLO_CLASSES=0,1,2,3,5,11,12,13 e MULTI_PERSON_DETECTION=true.
PPE_MODEL_PATH=models/visionepi_cppe_n416.pt
YOLO_CONFIDENCE=0.35
# Vazio = o ultralytics escolhe (CPU quando nao ha GPU).
# Em MacBook com Apple Silicon (M1/M2/M3/M4) vale testar YOLO_DEVICE=mps: o
# PyTorch usa a GPU via Metal e costuma render bem mais que a CPU. Em maquina
# com placa NVIDIA, use 0 (ou cuda:0). Se o valor nao existir na maquina, o
# ultralytics cai pra CPU sozinho — testar e barato.
YOLO_DEVICE=
# Filtro de classes do ultralytics. Vazio = todas — e o certo para o peso da
# Sprint 4, cujas 11 classes sao todas consumidas (as negativas alimentam o
# estado "negativa_detectada" do matcher).
#
# ATENCAO: sao indices DO MODELO carregado. Com o Vyra, use
# 0,1,2,3,5,11,12,13 (sem as NO-*) ou 0,1,2,3,5,6,7,8,9,10,11,12,13 (com).
# Trocar PPE_MODEL_PATH sem ajustar esta linha filtra as classes erradas.
YOLO_CLASSES=

# Modelo separado só para detectar pessoa (classe 0 COCO). E quem realmente
# encontra pessoas aqui — ver MULTI_PERSON_DETECTION abaixo para o motivo
# medido. Baixe uma vez com:
#   python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"
# e mova o arquivo para models/. O caminho tem que apontar para models/ (nao
# `yolov8n.pt` solto): com nome solto o ultralytics baixa no diretorio de
# trabalho de quem rodou, fora do unico lugar ignorado pelo git.
PERSON_MODEL_PATH=models/yolov8n.pt

# Uma pose POR PESSOA (recorte da caixa) em vez de uma pose global do frame.
# E o que permite atribuir queda/postura a um individuo. Custa N inferencias
# por frame, entao POSE_MAX_PEOPLE limita o pior caso numa cena cheia.
POSE_PER_PERSON=true
POSE_MAX_PEOPLE=4
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5

# Alertas operacionais ativos: cria após N frames ruins e resolve após M frames bons.
ALERT_COOLDOWN_SECONDS=0
ALERT_CREATE_AFTER_FRAMES=3
ALERT_RESOLVE_AFTER_FRAMES=5
# Segundos entre gravacoes de um alerta que CONTINUA ativo. Cada gravacao e
# um commit (~9 ms) feito dentro do loop de captura; antes acontecia por
# alerta A CADA FRAME, e com 5 alertas x 2 cameras x 24 FPS dava 240
# commits/s — o video travava exatamente quando havia infracao. Criar e
# resolver seguem imediatos. 0 volta ao comportamento antigo.
ALERT_TOUCH_INTERVAL_SECONDS=2.0
# Vezes por segundo que a telemetria (analysis/compliance) vai pro navegador.
# O VIDEO nao passa por aqui — e MJPEG com as caixas ja desenhadas — entao
# baixar isto nao deixa a imagem menos fluida. Mudanca de alerta ignora o
# intervalo e vai na hora.
TELEMETRY_HZ=8


DEFAULT_FEATURES=ppe,helmet,vest,gloves,glasses,mask,safety_shoe,pose,falls,posture,risk_area
RISK_AREA_POLYGON=0.70,0.10;0.98,0.10;0.98,0.95;0.70,0.95
SOCKETIO_CORS_ALLOWED_ORIGINS=*
SOCKETIO_ASYNC_MODE=threading

# Limpa artefatos de teste ao iniciar o monitoramento.
# Não apaga banco, modelos, código-fonte ou configurações.
CLEANUP_ON_MONITOR_START=true
CLEANUP_DIRECTORIES=runtime/snapshots,runtime/frames,runtime/tmp
SNAPSHOT_DIR=runtime/snapshots

# Segundo modelo YOLO (COCO) so pra detectar pessoa.
#
# Sprint 4: DESLIGADO com o peso proprio, por medicao. A classe Person dele
# generaliza no dominio (revocacao de pessoa 0,90 na validacao, contra 0,84
# do COCO na mesma imagem), e somar o COCO PIORA a avaliacao por pessoa
# (F1 capacete 0,88 -> 0,83 na validacao) custando o DOBRO de tempo
# (47 -> 98 ms por imagem). Travado por tests/test_onboarding.py.
#
# O historico abaixo continua valendo para o Vyra: com ele, LIGUE.
# (Sprints 2-3) LIGADO por medicao, nao por preferencia. O Vyra TEM a classe "Person"
# (indice 11) e por isso isto ficava desligado — mas a classe nao dispara em
# imagem real: 36 celulas testadas (3 fotos de canteiro com pessoas de corpo
# inteiro x imgsz 416/640/960/1280 x conf 0,35/0,10/0,02) devolveram ZERO
# deteccoes, confianca maxima 0,000, inclusive na resolucao de treino. Na
# matriz de confusao do proprio autor, "Person" tem ~277 instancias de
# validacao contra ~8.946 de "Hardhat": e a menor classe real do dataset.
#
# Com isto em false, person_compliance_matcher.py recebe lista de pessoas
# vazia — o sistema desenha capacete e colete no video e NUNCA avalia a
# conformidade de ninguem. Nenhum alerta de EPI e criado.
#
# Custo medido: -20% de FPS (24,32 -> 19,42 a imgsz=416). Ver docs/BENCH.md.
# MediaPipe (pose) e independente disto.
MULTI_PERSON_DETECTION=false
# O que fazer quando NENHUMA caixa de um EPI (positiva ou negativa) foi
# associada a pessoa:
#   ausencia  = alerta (a pessoa conta como sem o EPI). DEFAULT.
#   evidencia = "nao verificado", sem alerta; so alerta quem foi VISTO sem o
#               EPI. Com ela o LLM e chamado quando o "nao verificado" persiste.
# Escolhido na VALIDACAO (nunca no teste), F1 medio capacete+colete:
#   ausencia 0,83 · evidencia 0,62 (a conf 0,35). A evidencia acerta 100% dos
#   alertas de capacete que dispara, mas so dispara 27% dos devidos: as classes
#   negativas sao as mais fracas do peso (mAP50 no_helmet 0,43 na validacao, 0,14 no teste). Ver SPRINT4.md.
PPE_MISSING_POLICY=ausencia
YOLO_MAX_DETECTIONS=100
# --- Custo da inferencia -------------------------------------------------
# Lado maior da imagem que entra na rede (o ultralytics usa 640 se omitido).
# E o item mais caro do pipeline: medido em CPU sem CUDA, o YOLOv8m leva
# 327 ms/frame a 640 contra 207 ms a 416 e 135 ms a 320. Menor = mais FPS e
# pior deteccao de objeto pequeno/distante.
YOLO_IMGSZ=416
# Roda o YOLO 1 frame a cada N; os intermediarios reaproveitam as ultimas
# caixas. Desacopla a fluidez do video da velocidade do modelo — necessario
# com mais de uma camera, porque a inferencia e serializada entre elas.
# 1 = detecta em todo frame (mais preciso, muito mais caro).
DETECTION_EVERY_N_FRAMES=3


# Overlay visual do vídeo. Dados operacionais ficam fora do frame.
OVERLAY_SHOW_BOXES=true
OVERLAY_SHOW_LABELS=true
OVERLAY_SHOW_CONFIDENCE=true
OVERLAY_SHOW_POSE=true
OVERLAY_SHOW_RISK_AREA=true

# Sprint 3: evidências, timeline e área de risco runtime.
RISK_AREA_NAME=Área de risco
SNAPSHOT_ENABLED=true
SNAPSHOT_JPEG_QUALITY=86
TIMELINE_LIMIT=80

# --- Camada LLM multimodal (Sprint 3) -----------------------------------
# Analise contextual de risco por modelo multimodal, disparada por evento de
# alerta criado. NUNCA entra no caminho do frame: a chamada roda fora da thread
# do loop de captura, com no maximo uma em voo por camera.
#
# SEM CHAVE O SISTEMA FUNCIONA NORMALMENTE, sem a camada LLM. E degradacao
# explicita, nao erro: o analisador devolve None e o pipeline segue.
#
# Obtenha a chave em https://aistudio.google.com/apikey (free tier).
# Deixe VAZIO aqui. Este arquivo e versionado num repositorio PUBLICO — uma
# chave real fica no historico do git para sempre, mesmo se removida depois.
# Travado por tests/test_onboarding.py.
GEMINI_API_KEY=
# gemini-2.0-flash foi APOSENTADO: a API responde 404 com
# "no longer available. Please update your code to use models/gemini-3.6-flash".
# Versao FIXA e nao um alias tipo `gemini-flash-latest`: os goldens em
# tests/goldens/ precisam ser reprodutiveis, e um alias flutuante faria o
# mesmo arquivo significar modelos diferentes com o tempo.
GEMINI_MODEL=gemini-3.6-flash

# Liga a camada. Fica false por padrao: sem chave ela nao faz nada de todo
# jeito, e ligar por acidente num demo sem rede so gera log de timeout.
LLM_ENABLED=false
# Teto por chamada. Estourou, ignora o evento e segue — nunca segura o frame.
# 30 s e nao 8 s, por medicao: a API recusa deadline abaixo de 10 s (HTTP 400
# "Minimum allowed deadline is 10s") e o gemini-3.6-flash respondeu em 22,9 s
# e 26,8 s nas cenas reais. Com 8 s, toda chamada seria abortada e a camada
# gastaria cota sem nunca produzir nada.
LLM_TIMEOUT_S=30.0
# Janela minima entre duas analises da MESMA camera. Depois do fix da Fase 1 a
# fixture de 7 s ainda gera 26 alertas; chamar o Gemini em cada um estoura a
# cota do free tier e inunda a tela.
LLM_DEBOUNCE_S=15.0
# Versao de prompt em uso (app/llm/prompts/). Ver docs/SPRINT3.md para o que
# muda entre v1 e v2.
LLM_PROMPT_VERSION=v2

# --- Cameras RTSP da planta ----------------------------------------------
# A URL das Dahua carrega `usuario:senha@host`. A CREDENCIAL NAO ENTRA AQUI:
# este arquivo e versionado num repositorio PUBLICO, e senha de rede
# industrial de terceiro vazada e acesso ao parque de cameras de outra
# empresa. Deixe os dois campos VAZIOS e preencha no .env, que e ignorado
# pelo git. Travado por tests/test_credencial_rtsp.py.
RTSP_USUARIO=
RTSP_SENHA=
# Host e caminho podem ficar: sao rede privada 10.14.x.x e nao valem nada
# sozinhos. Cadastre com `flask --app wsgi cameras add` (ver README), que monta
# a URL a partir destas variaveis sem ninguem digitar senha no terminal.
RTSP_PORTA=554
# Caminho COM parametros, nao com subtype fixo: `{canal}` e `{subtype}` sao
# preenchidos por `cameras add`. Sem os dois placeholders o comando falha alto,
# porque `--subtype` seria aceito e ignorado em silencio.
RTSP_CAMINHO=/cam/realmonitor?channel={canal}&subtype={subtype}
# 0 = stream principal, 1 = substream. Doc oficial Dahua (Network Camera Web
# 3.0 Operation Manual V2.1.5, p. 79): "0 means main stream (Subtype=0) and 1
# means sub stream (Subtype=1)". As URLs recebidas da planta usam subtype=0,
# ou seja o PRINCIPAL. Aqui o default e 1 por medicao: esta maquina e CPU-only
# e a resolucao e a maior alavanca do pipeline (416->640 = -42% de FPS, ver
# docs/BENCH.md), entao imagem menor direto da camera sai mais barato.
RTSP_SUBTYPE=1
# Fonte de reserva quando a rede da planta nao responde. E o seguro do demo.
RTSP_FIXTURE_FALLBACK=tests/fixtures/bench.mp4
# Tentativas de reconexao antes de assumir a fonte de demonstracao.
# 2, e nao 5, por medicao contra um endereco da planta que nao tem rota desta
# maquina (cada tentativa custa o teto de abertura de 5 s):
#   1 ->  5,3 s     2 -> 10,9 s     3 -> 17,0 s     5 -> 33,2 s
# 33 s de tela em "reconectando" na frente de um avaliador e o pior cenario de
# apresentacao; 11 s cabe numa frase de contexto. O custo de baixar: com 2 a
# camera assume a fixture mais cedo, entao em rede instavel uma queda
# passageira vira troca para a fonte de demonstracao em vez de reconexao.
# SUBA PARA 5 se a rede da planta estiver acessivel (docs/DEMO.md, passo 5).
RTSP_MAX_TENTATIVAS=2
# Descarte de frame atrasado em fonte de REDE: acima de quantos ms um grab()
# conta como "esperou a rede" em vez de "veio do buffer".
#
# Existe porque CAP_PROP_BUFFERSIZE=1 e RECUSADO pelo backend FFMPEG (medido:
# set() -> False, e 104 frames enfileirados apos 10 s sem ler). Sem descarte, o
# atraso do video crescia +135 ms/s; com ele, ficou estavel em 2,55 s e deriva
# zero (docs/BENCH.md, Fase 7).
#
# 5 ms calibrado contra localhost: grab bufferizado custa microssegundos e o
# frame vivo custa ~1/fps (67 ms a 15 fps). PRIMEIRO numero a ajustar em campo,
# porque rede industrial tem jitter. Sintoma de cada lado do erro em
# docs/DEMO.md. Nao afeta webcam nem arquivo: la nao ha fila.
RTSP_LIMIAR_GRAB_MS=5.0

# --- Fonte CEGA: o frame chega, a imagem nao ----------------------------
# Brilho medio abaixo do qual o frame conta como "sem imagem". MEDIDO: uma
# webcam cujo stream o Windows zera (porque OUTRO APP ja a tinha aberto)
# entrega media de pixel 0,01 a 0,034 e maximo 3, com o ganho da camera no
# teto (255). O sistema aceitava isso em silencio — video preto, inferencia em
# nada, FPS saudavel — e quem testasse noutra maquina concluiria que o projeto
# esta quebrado. Agora o painel de diagnostico acusa.
#
# 2.0 fica ~60x acima do medido de proposito: o alvo e imagem ZERADA, nao
# imagem escura. E SO DIAGNOSTICO: nao para a captura e nao cria alerta.
#
# NAO VERIFICADO quanto marca uma cena legitimamente escura (galpao a noite).
# Se um turno noturno acusar fonte cega, BAIXE este valor. Custo da checagem:
# 0,0156 ms por segundo de operacao (docs/BENCH.md, Fase 10).
FONTE_BRILHO_MINIMO=2.0
# Segundos consecutivos abaixo do limiar antes de a tela acusar. Curto demais
# e uma pessoa passando na frente da lente acende o aviso; longo demais e quem
# esta testando desiste antes de aparecer.
FONTE_BRILHO_JANELA_S=5.0
