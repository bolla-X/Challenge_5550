# OBRIGATORIO trocar: e o que assina a sessao de login. Com o valor padrao
# do repositorio, qualquer pessoa forja o cookie de um supervisor — por
# isso a aplicacao se RECUSA a subir com ele fora de FLASK_DEBUG.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Deixe VAZIO e preencha com uma chave sua: a aplicacao recusa subir com
# qualquer valor que conste neste repositorio, e com menos de 32 caracteres.
SECRET_KEY=

# Autenticacao. Desligar so faz sentido em teste automatizado.
AUTH_REQUIRED=true
# LIGUE atras de HTTPS. Fica false por padrao porque cookie Secure nao
# viaja em http://localhost e quebraria o desenvolvimento.
SESSION_COOKIE_SECURE=false
# Quanto tempo a sessao dura sem novo login.
SESSION_HOURS=12

# Porta unica do backend — usada por run.py, Dockerfile, docker-compose e
# pelo proxy do Vite em dev. Mude aqui e muda em todos.
HOST=0.0.0.0
PORT=5000
# NUNCA true em producao: liga o console interativo do Werkzeug (RCE).
FLASK_DEBUG=false
# DATABASE_URL=postgresql+psycopg2://visionepi:visionepi@localhost:5432/visionepi  # opcional -- sem isso usa SQLite local, recomendado pra testar/clonar
AUTO_CREATE_TABLES=true
VIDEO_SOURCE=0
FRAME_WIDTH=960
FRAME_HEIGHT=540
TARGET_FPS=12
JPEG_QUALITY=80

# Modelo YOLOv8m treinado para EPIs (Hexmon/vyra-yolo-ppe-detection, CC-BY-4.0).
# 14 classes: Fall-Detected, Gloves, Goggles, Hardhat, Ladder, Mask, NO-Gloves,
# NO-Goggles, NO-Hardhat, NO-Mask, NO-Safety Vest, Person, Safety Cone, Safety Vest.
#
# Os pesos NAO estao no repositorio (.gitignore: *.pt). Baixe de
# https://huggingface.co/Hexmon/vyra-yolo-ppe-detection e salve como
# models/vyra_ppe.pt. A licenca CC-BY-4.0 exige atribuicao ao autor.
#
# Alternativa sem classe "person" (exige MULTI_PERSON_DETECTION=true e
# YOLO_CLASSES vazio): Tanishjain9/yolov8n-ppe-detection-6classes, MIT,
# em models/epi_pretrained.pt.
# Aponte para o .pt para rodar no PyTorch, ou para o diretorio exportado
# *_openvino_model para usar o runtime da Intel — 5,6x mais rapido nesta
# classe de CPU (24 ms/frame contra 186 ms). Gerar o diretorio com:
#   YOLO("models/vyra_ppe.pt").export(format="openvino", imgsz=416)
# ATENCAO: o OpenVINO CONGELA a resolucao na exportacao — YOLO_IMGSZ abaixo
# precisa bater com o imgsz usado no export, senao a aplicacao recusa subir
# com uma mensagem explicando (ver YoloPPEDetector._validar_imgsz).
PPE_MODEL_PATH=models/vyra_ppe_openvino_model
YOLO_CONFIDENCE=0.35
# Vazio = o ultralytics escolhe (CPU quando nao ha GPU).
# Em MacBook com Apple Silicon (M1/M2/M3/M4) vale testar YOLO_DEVICE=mps: o
# PyTorch usa a GPU via Metal e costuma render bem mais que a CPU. Em maquina
# com placa NVIDIA, use 0 (ou cuda:0). Se o valor nao existir na maquina, o
# ultralytics cai pra CPU sozinho — testar e barato.
YOLO_DEVICE=
# Filtra as classes do Vyra que o sistema usa: 0 Fall-Detected, 1 Gloves,
# 2 Goggles, 3 Hardhat, 5 Mask, 11 Person, 12 Safety Cone, 13 Safety Vest.
# Exclui 4 Ladder e as classes NO-* (6..10) de proposito.
#
# ATENCAO: sao indices DESTE modelo. Trocar PPE_MODEL_PATH sem limpar esta
# linha filtra as classes erradas (ou nenhuma) em silencio. Vazio = sem filtro.
YOLO_CLASSES=0,1,2,3,5,11,12,13

# Modelo separado só para detectar pessoa (classe 0 COCO). So e necessario
# quando PPE_MODEL_PATH aponta pra um modelo de EPI SEM classe "person"
# propria. O Vyra ja detecta "Person", entao fica desligado (ver abaixo).
PERSON_MODEL_PATH=yolov8n.pt

# Uma pose POR PESSOA (recorte da caixa) em vez de uma pose global do frame.
# E o que permite atribuir queda/postura a um individuo. Custa N inferencias
# por frame, entao POSE_MAX_PEOPLE limita o pior caso numa cena cheia.
POSE_PER_PERSON=true
POSE_MAX_PEOPLE=4
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5

# Alertas operacionais ativos: cria após N frames ruins e resolve após M frames bons.
ALERT_COOLDOWN_SECONDS=0
ALERT_CREATE_AFTER_FRAMES=3
ALERT_RESOLVE_AFTER_FRAMES=5
# Segundos entre gravacoes de um alerta que CONTINUA ativo. Cada gravacao e
# um commit (~9 ms) feito dentro do loop de captura; antes acontecia por
# alerta A CADA FRAME, e com 5 alertas x 2 cameras x 24 FPS dava 240
# commits/s — o video travava exatamente quando havia infracao. Criar e
# resolver seguem imediatos. 0 volta ao comportamento antigo.
ALERT_TOUCH_INTERVAL_SECONDS=2.0
# Vezes por segundo que a telemetria (analysis/compliance) vai pro navegador.
# O VIDEO nao passa por aqui — e MJPEG com as caixas ja desenhadas — entao
# baixar isto nao deixa a imagem menos fluida. Mudanca de alerta ignora o
# intervalo e vai na hora.
TELEMETRY_HZ=8


DEFAULT_FEATURES=ppe,helmet,vest,gloves,glasses,mask,safety_shoe,pose,falls,posture,risk_area
RISK_AREA_POLYGON=0.70,0.10;0.98,0.10;0.98,0.95;0.70,0.95
SOCKETIO_CORS_ALLOWED_ORIGINS=*
SOCKETIO_ASYNC_MODE=threading

# Limpa artefatos de teste ao iniciar o monitoramento.
# Não apaga banco, modelos, código-fonte ou configurações.
CLEANUP_ON_MONITOR_START=true
CLEANUP_DIRECTORIES=runtime/snapshots,runtime/frames,runtime/tmp
SNAPSHOT_DIR=runtime/snapshots

# Segundo modelo YOLO (COCO) so pra detectar pessoa. Desligado porque o Vyra
# ja detecta "Person" nativamente. Ligue de volta se apontar PPE_MODEL_PATH
# pra um modelo sem essa classe. MediaPipe (pose) e independente disto.
MULTI_PERSON_DETECTION=false
YOLO_MAX_DETECTIONS=100
# --- Custo da inferencia -------------------------------------------------
# Lado maior da imagem que entra na rede (o ultralytics usa 640 se omitido).
# E o item mais caro do pipeline: medido em CPU sem CUDA, o YOLOv8m leva
# 327 ms/frame a 640 contra 207 ms a 416 e 135 ms a 320. Menor = mais FPS e
# pior deteccao de objeto pequeno/distante.
YOLO_IMGSZ=416
# Roda o YOLO 1 frame a cada N; os intermediarios reaproveitam as ultimas
# caixas. Desacopla a fluidez do video da velocidade do modelo — necessario
# com mais de uma camera, porque a inferencia e serializada entre elas.
# 1 = detecta em todo frame (mais preciso, muito mais caro).
DETECTION_EVERY_N_FRAMES=3


# Overlay visual do vídeo. Dados operacionais ficam fora do frame.
OVERLAY_SHOW_BOXES=true
OVERLAY_SHOW_LABELS=true
OVERLAY_SHOW_CONFIDENCE=true
OVERLAY_SHOW_POSE=true
OVERLAY_SHOW_RISK_AREA=true

# Sprint 3: evidências, timeline e área de risco runtime.
RISK_AREA_NAME=Área de risco
SNAPSHOT_ENABLED=true
SNAPSHOT_JPEG_QUALITY=86
TIMELINE_LIMIT=80
